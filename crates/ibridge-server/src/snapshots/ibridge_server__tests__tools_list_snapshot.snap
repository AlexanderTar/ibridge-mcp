[
  {
    "name": "account_status",
    "title": "Get account status",
    "description": "Reports the signed-in address, each service, and the server version.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ServiceOut": {
          "properties": {
            "name": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/ServiceState"
            }
          },
          "required": [
            "name",
            "status",
            "reason"
          ],
          "type": "object"
        },
        "ServiceState": {
          "enum": [
            "on",
            "off"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "apple_id": {
          "type": "string"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceOut"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "apple_id",
        "services",
        "version"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
