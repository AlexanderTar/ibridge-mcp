  {
    "name": "mail_get_attachment",
    "title": "Get attachment",
    "description": "Fetches one attachment as text or as a small inline file. The file name and text are as the sender wrote them.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Opaque message id.",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "description": "Unicode scalar offset into a text part. Omitted means the start.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "part": {
          "description": "Part identifier from `mail_get_message`.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "part"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "bytes_base64": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "next_offset": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content_type",
        "name",
        "size",
        "text",
        "bytes_base64",
        "next_offset"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "mail_get_message",
    "title": "Get message",
    "description": "Fetches one message, including its text and attachment list. The subject and body are as the sender wrote them.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Opaque message id.",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "description": "Unicode scalar offset into the body. Omitted means the start.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "AttachmentInfoOut": {
          "properties": {
            "content_type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "part": {
              "type": "string"
            },
            "size": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "part",
            "content_type",
            "size",
            "name"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentInfoOut"
          },
          "type": "array"
        },
        "body": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "next_offset": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "subject": {
          "type": "string"
        },
        "to": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "subject",
        "date",
        "body",
        "attachments",
        "next_offset"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": true
    }
