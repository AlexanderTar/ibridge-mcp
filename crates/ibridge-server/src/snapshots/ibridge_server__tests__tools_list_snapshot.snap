            "role": {
              "type": "string"
            },
            "total": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "unread": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "path",
            "role",
            "total",
            "unread"
          ],
          "type": "object"
        }
