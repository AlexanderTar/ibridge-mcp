{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AlexanderTar/ibridge",
  "title": "iBridge",
  "description": "Read, search and manage iCloud Mail, Calendar and Contacts from Claude and other MCP clients.",
  "version": "1.0.1",
  "websiteUrl": "https://ibridge.fyi",
  "icons": [
    {
      "src": "https://mcp.ibridge.fyi/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    },
    {
      "src": "https://mcp.ibridge.fyi/favicon-32.png",
      "mimeType": "image/png",
      "sizes": ["32x32"]
    }
  ],
  "repository": {
    "url": "https://github.com/AlexanderTar/ibridge-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "cargo",
      "registryBaseUrl": "https://crates.io",
      "identifier": "ibridge",
      "version": "1.0.1",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "IBRIDGE_APPLE_ID",
          "description": "The email address you sign in to iCloud with.",
          "isRequired": true
        },
        {
          "name": "IBRIDGE_APP_PASSWORD",
          "description": "An app-specific password created at account.apple.com. It is not your Apple ID password.",
          "isRequired": true,
          "isSecret": true
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.ibridge.fyi/mcp"
    }
  ]
}
