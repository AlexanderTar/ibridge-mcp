  {
    "name": "mail_move",
    "title": "Move message",
    "description": "Moves a message to a mailbox or a role.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Opaque message id.",
          "type": "string"
        },
        "mailbox": {
          "default": null,
          "description": "Mailbox path. Set this or `role`, not both.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "default": null,
          "description": "Role: inbox, archive, trash, junk, sent, drafts, or notes.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "moved": {
          "type": "boolean"
        }
      },
      "required": [
        "moved"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "mail_search",
    "title": "Search mail",
    "description": "Searches messages, newest first. Subjects are as the sender wrote them.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "before": {
          "default": null,
          "description": "Messages before this date.",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "default": null,
          "description": "Cursor from the previous page.",
          "type": [
            "string",
            "null"
          ]
        },
        "flagged": {
          "default": null,
          "description": "When set, only flagged messages.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "from": {
          "default": null,
          "description": "From header contains this text.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 25,
          "description": "Page size. Omitted means 25. More than 100 is rejected.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mailbox": {
          "default": null,
          "description": "Mailbox path. Omit to use `role` or the inbox.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "default": null,
          "description": "Well-known role: inbox, sent, drafts, trash, junk, archive, notes.",
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "default": null,
          "description": "Messages on or after this date.",
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "default": null,
          "description": "Subject contains this text.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "default": null,
          "description": "Body or subject contains this text.",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "default": null,
          "description": "To header contains this text.",
          "type": [
            "string",
            "null"
          ]
        },
        "unread": {
          "default": null,
          "description": "When set, only unseen messages.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "SearchHitOut": {
          "properties": {
            "date": {
              "type": "string"
            },
            "flagged": {
              "type": "boolean"
            },
            "from": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "unread": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "from",
            "subject",
            "date",
            "unread",
            "flagged"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "messages": {
          "items": {
            "$ref": "#/$defs/SearchHitOut"
          },
          "type": "array"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "messages",
        "next_cursor",
        "warnings"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
